# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.qss text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.stl binary
*.obj binary
*.step binary
*.stp binary
